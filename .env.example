# ============================================================
# AQI Health Risk System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.

# ── AQICN (World Air Quality Index) API ─────────────────────
# Get your free token at: https://aqicn.org/data-platform/token/
AQICN_TOKEN=your_aqicn_token_here

# ── Optional: AQI.in API (if you get access later) ──────────
# AQI_API_KEY=your_aqi_in_key_here

# ── App settings ────────────────────────────────────────────
# How often (minutes) to auto-collect live data per city
COLLECTION_INTERVAL_MINUTES=60

# Set to "true" to use mock data instead of real API calls
# Useful for testing when you don't have a token yet
USE_MOCK_DATA=false
